# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL="gemini-2.5-pro"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
NEXT_PUBLIC_SITE_URL="https://talkhumanly.com"
NEXT_PUBLIC_CONTACT_EMAIL="karma@talkhumanly.com"
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""

# Stripe Checkout
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# OPTIONAL: per-service Stripe Price IDs. If unset, checkout falls back to
# inline price_data using the USD amounts in lib/products.ts (no Price ID needed).
# Set these only if you want fixed Stripe Prices (e.g. for reporting/coupons).
# ⚠️ If one of these IS set, Stripe's stored price WINS and the amountAed in lib/products.ts is
# ignored for the actual charge. Repricing in code then has no effect. Prefer leaving them unset.
# Core advisory ladder
STRIPE_PRICE_THE_SESSION="price_..."
STRIPE_PRICE_SESSION_PLUS_PLAN="price_..."
STRIPE_PRICE_FULL_SUPPORT="price_..."
# Specialist sessions
STRIPE_PRICE_INTERVIEW_PREP="price_..."
STRIPE_PRICE_DUBAI_JOB_SEARCH="price_..."
STRIPE_PRICE_DOCUMENT_REVIEW="price_..."
STRIPE_PRICE_INTERVIEW_PREP_PACKAGE="price_..."
# Monthly retainers
STRIPE_PRICE_ESSENTIAL_RETAINER="price_..."
STRIPE_PRICE_CAREER_TRANSITION_RETAINER="price_..."
STRIPE_PRICE_EXECUTIVE_RETAINER="price_..."
# RETIRED Sept 2026 — delete these from the Vercel project. Their products live on in
# `retiredServiceProducts` so historical orders stay readable, but nothing sells them:
#   STRIPE_PRICE_INDIVIDUAL_ADVISORY / _EXTENDED_ADVISORY / _UAE_RELOCATION_QA
#   STRIPE_PRICE_LUNCH_AND_LEARN / _HR_COMPLIANCE_ADVISORY

# Resend
RESEND_API_KEY="re_..."
RESEND_FROM="Humanly <hello@talkhumanly.com>"
# Where internal lead notifications (intake-form details) are sent. Defaults to hello@talkhumanly.com.
LEAD_NOTIFICATION_EMAIL="hello@talkhumanly.com"


# OPTIONAL. https URL of a one-click unsubscribe endpoint. While this is unset, the
# review-request email ships `List-Unsubscribe: <mailto:...>` only — RFC 8058 requires an
# https target for `List-Unsubscribe-Post`, so pairing that header with a mailto is
# malformed and is deliberately omitted. Set this once such a route exists and both
# headers ship compliant with no code change.
EMAIL_UNSUBSCRIBE_URL=""
# Cal.com — the account every event type hangs off. The username is HYPHENATED: `talk-humanly`.
# (`talkhumanly` is not a Cal.com account; the API answers "User with username talkhumanly not
# found", which is a 404 booking page for anyone who has already paid.)
NEXT_PUBLIC_CAL_USERNAME="talk-humanly"

# One event type per scheduled service. Create these in Cal.com with the durations shown.
# Document Review is async — its event type is never used.
#
# ⚠️ These are not optional in practice. getCalLink() falls back to `<username>/<product slug>`
# and now logs a warning when it does, because the fallback is only correct if that event type
# actually exists. As of 2026-09-04 `the-session`, `session-plus-plan` and `full-support` DO NOT
# exist under `talk-humanly` (checked against the live v2 API) — until they are created, those
# three services show an empty availability preview and send paying customers to a dead booking
# page. Create the event type first, then set the var here, in .env.local and in Vercel.
NEXT_PUBLIC_CAL_LINK_THE_SESSION="talk-humanly/the-session"                       # 30 min
NEXT_PUBLIC_CAL_LINK_SESSION_PLUS_PLAN="talk-humanly/session-plus-plan"           # 60 min
NEXT_PUBLIC_CAL_LINK_FULL_SUPPORT="talk-humanly/full-support"                     # 60 min
NEXT_PUBLIC_CAL_LINK_INTERVIEW_PREP="talk-humanly/interview-prep"                 # 60 min
NEXT_PUBLIC_CAL_LINK_DUBAI_JOB_SEARCH="talk-humanly/dubai-job-search"             # 30 min
NEXT_PUBLIC_CAL_LINK_INTERVIEW_PREP_PACKAGE="talk-humanly/interview-prep-package" # 60 min
NEXT_PUBLIC_CAL_LINK_DOCUMENT_REVIEW="talk-humanly/document-review"               # async, unused
NEXT_PUBLIC_CAL_LINK_ESSENTIAL_RETAINER="talk-humanly/essential-retainer"         # 60 min
NEXT_PUBLIC_CAL_LINK_CAREER_TRANSITION_RETAINER="talk-humanly/career-transition-retainer"
NEXT_PUBLIC_CAL_LINK_EXECUTIVE_RETAINER="talk-humanly/executive-retainer"
# RETIRED Sept 2026 — delete these vars AND their Cal.com event types:
#   NEXT_PUBLIC_CAL_LINK_INDIVIDUAL_ADVISORY / _EXTENDED_ADVISORY / _UAE_RELOCATION_QA
#   NEXT_PUBLIC_CAL_LINK_LUNCH_AND_LEARN / _HR_COMPLIANCE_ADVISORY

# Shared secret for the Cal.com booking webhook → /api/webhooks/cal.
CAL_WEBHOOK_SECRET="change-me"
# Cal.com v2 API key. Server-only, never NEXT_PUBLIC_. Its only consumer is lib/cal.ts, which
# READS /slots for the pre-payment availability preview and never writes a booking. If this is
# unset the preview is empty everywhere; booking itself is unaffected.
CAL_API_KEY="cal_..."

# Review pipeline (see docs/adr/0001-pricing-currency-availability-reviews.md, Decision D)
# HMAC secret for stateless /review/<token> links. Rotating this invalidates every outstanding
# review-request link at once, so treat it as a break-glass action, not routine hygiene.
REVIEW_TOKEN_SECRET="change-me"
# Guards app/api/cron/review-requests. Set it as a normal Vercel PROJECT ENVIRONMENT VARIABLE —
# Vercel then sends it automatically as `Authorization: Bearer $CRON_SECRET` when it invokes the
# schedule in vercel.json. There is no secret field in vercel.json itself.
CRON_SECRET="change-me"

# Vercel stack
DATABASE_URL="postgres://..."
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Clerk admin dashboard
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
ADMIN_EMAILS="karma@talkhumanly.com"

# Sanity CMS (Studio at /studio). Content falls back to in-code copy when unset.
NEXT_PUBLIC_SANITY_PROJECT_ID="your_project_id"
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_API_VERSION="2026-07-22"
# Editor token (read+write). Used by scripts/seed-sanity.ts, and by server content
# fetches when SANITY_API_READ_TOKEN is unset. Server-only — never NEXT_PUBLIC_.
SANITY_API_WRITE_TOKEN="sk..."
# Optional Viewer token for server content fetches. Set this (and make the dataset
# private) if you don't want drafts readable over the public API.
SANITY_API_READ_TOKEN=""
# Shared secret for the Sanity publish webhook → /api/revalidate. Set the SAME value
# in the Sanity webhook (Manage → API → Webhooks) so cache purges are authenticated.
SANITY_REVALIDATE_SECRET="a_long_random_string"
