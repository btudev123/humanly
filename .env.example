# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL="gemini-2.5-pro"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
NEXT_PUBLIC_SITE_URL="https://talkhumanly.com"
NEXT_PUBLIC_CONTACT_EMAIL="karma@talkhumanly.com"
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""

# Stripe Checkout
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# OPTIONAL: per-service Stripe Price IDs. If unset, checkout falls back to
# inline price_data using the USD amounts in lib/products.ts (no Price ID needed).
# Set these only if you want fixed Stripe Prices (e.g. for reporting/coupons).
STRIPE_PRICE_INDIVIDUAL_ADVISORY="price_..."
STRIPE_PRICE_DUBAI_JOB_SEARCH="price_..."
STRIPE_PRICE_UAE_RELOCATION_QA="price_..."
STRIPE_PRICE_EXTENDED_ADVISORY="price_..."
STRIPE_PRICE_DOCUMENT_REVIEW="price_..."
STRIPE_PRICE_ESSENTIAL_RETAINER="price_..."
STRIPE_PRICE_CAREER_TRANSITION_RETAINER="price_..."
STRIPE_PRICE_EXECUTIVE_RETAINER="price_..."
STRIPE_PRICE_LUNCH_AND_LEARN="price_..."
STRIPE_PRICE_HR_COMPLIANCE_ADVISORY="price_..."
STRIPE_PRICE_INTERVIEW_PREP="price_..."
STRIPE_PRICE_INTERVIEW_PREP_PACKAGE="price_..."

# Resend
RESEND_API_KEY="re_..."
RESEND_FROM="Humanly <hello@talkhumanly.com>"
# Where internal lead notifications (intake-form details) are sent. Defaults to hello@talkhumanly.com.
LEAD_NOTIFICATION_EMAIL="hello@talkhumanly.com"

# Cal.com — one event type per scheduled service. Defaults to talkhumanly/<slug>
# if unset. Create matching event types in Cal.com. Document Review is async and
# needs no event type.
NEXT_PUBLIC_CAL_LINK_INDIVIDUAL_ADVISORY="talkhumanly/individual-advisory"
NEXT_PUBLIC_CAL_LINK_DUBAI_JOB_SEARCH="talkhumanly/dubai-job-search"
NEXT_PUBLIC_CAL_LINK_UAE_RELOCATION_QA="talkhumanly/uae-relocation-qa"
NEXT_PUBLIC_CAL_LINK_EXTENDED_ADVISORY="talkhumanly/extended-advisory"
NEXT_PUBLIC_CAL_LINK_ESSENTIAL_RETAINER="talkhumanly/essential-retainer"
NEXT_PUBLIC_CAL_LINK_CAREER_TRANSITION_RETAINER="talkhumanly/career-transition-retainer"
NEXT_PUBLIC_CAL_LINK_EXECUTIVE_RETAINER="talkhumanly/executive-retainer"
NEXT_PUBLIC_CAL_LINK_LUNCH_AND_LEARN="talkhumanly/lunch-and-learn"
NEXT_PUBLIC_CAL_LINK_HR_COMPLIANCE_ADVISORY="talkhumanly/hr-compliance-advisory"
NEXT_PUBLIC_CAL_LINK_INTERVIEW_PREP="talkhumanly/interview-prep"
NEXT_PUBLIC_CAL_LINK_INTERVIEW_PREP_PACKAGE="talkhumanly/interview-prep-package"
CAL_WEBHOOK_SECRET="change-me"

# Vercel stack
DATABASE_URL="postgres://..."
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Clerk admin dashboard
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
ADMIN_EMAILS="karma@talkhumanly.com"

# Sanity CMS (Studio at /sanity). Content falls back to in-code copy when unset.
NEXT_PUBLIC_SANITY_PROJECT_ID="your_project_id"
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_API_VERSION="2026-07-22"
# Shared secret for the Sanity publish webhook → /api/revalidate. Set the SAME value
# in the Sanity webhook (Manage → API → Webhooks) so cache purges are authenticated.
SANITY_REVALIDATE_SECRET="a_long_random_string"
